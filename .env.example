# Env del Showroom Mario Bravo 955
# Copiá este archivo a `.env.local` y completá los valores reales (NO commitear .env.local).
# En producción, cargá estas mismas variables en el panel del host (Netlify / Hostinger).
#
# Nada de esto es obligatorio para levantar el showroom en local: sin Airtable la app
# cae a src/data/units.json, y sin Resend el formulario de contacto devuelve 500.

# ── Airtable — data EN VIVO (estado, precio, tipología, ambientes, superficies) ──
# ⚠ Cada showroom necesita su PROPIA base y sus propios table IDs. No reutilices los
# de otro proyecto: el match es por la columna "Unidad" (TEXTO) contra las keys de
# units.json, y mezclar bases pinta unidades ajenas.
#
# Columnas que lee el sitio en la base de TIER Bravo (ver README § Data en vivo):
#   Unidad · Piso · Ambientes · Precio USD · Superficie Total / Cubierta / Semi-Desc
# ⚠ FALTA la columna "Estado" (Disponible / Reservada): sin ella todas las unidades
# se pintan como disponibles. El código también acepta "Estado de la unidad".
#
# Personal Access Token de Airtable (https://airtable.com/create/tokens)
# Scopes: data.records:read · Acceso: la base de Mario Bravo 955
AIRTABLE_TOKEN=pat_xxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base y tablas de TIER Bravo (no son secretas; el token sí):
#   AIRTABLE_BASE_ID=appVdj9WzBYpKtUcu
#   AIRTABLE_UNITS_TABLE_ID=tble9NSwIDP5yAtuJ
#   AIRTABLE_AVANCE_TABLE_ID=tbldUfUyV1eoT8gBe

# ID de la base (empieza con "app")
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ID de la tabla de unidades (empieza con "tbl")
AIRTABLE_UNITS_TABLE_ID=tblXXXXXXXXXXXXXX

# ID de la tabla de avance de obra (empieza con "tbl"). Opcional: sin esto, el
# modal "Avance de obra" muestra el estado vacío.
AIRTABLE_AVANCE_TABLE_ID=tblXXXXXXXXXXXXXX

# ── Resend — emails de los formularios de contacto ───────────────────────────
# API key de Resend (https://resend.com/api-keys). Sin ella, /api/contact da 500.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bandeja donde llegan los leads. ⚠ PENDIENTE: definir la casilla real con el cliente.
# SIN dominio verificado, Resend sólo entrega a la cuenta dueña de la key (modo test).
EMAIL_TO=
# Bandeja de la INMOBILIARIA que comercializa. El lead va acá cuando la visita entró
# por SU link (`?v=inmobiliaria`, ver README § Dos comercializadores, un formulario).
# Si queda vacía, esos leads NO se pierden: caen en EMAIL_TO y el mail dice "Vino por".
EMAIL_TO_INMOBILIARIA=
# (opcional) Remitente. Default: "Showroom Mario Bravo 955 <onboarding@resend.dev>"
# (funciona sin dominio). Con dominio verificado, usar el propio:
# EMAIL_FROM=Showroom Mario Bravo 955 <consultas@tu-dominio>

# ── Sitio / SEO ──────────────────────────────────────────────────────────────
# URL absoluta de producción (sin barra final): canonical, og:url, sitemap y
# og:image absoluta. ⚠ PENDIENTE: el dominio todavía no está definido — mientras
# tanto, PROD_SITE_URL en src/lib/seo.ts tiene un placeholder.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio

# ── PostHog — analítica de producto ──────────────────────────────────────────
# Token público del proyecto PostHog y host de ingestión. Configurarlos también
# en el panel del host para los builds y deploys de producción.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host.example
# SOLO LOCAL. Reemplaza el origen de las propiedades de URL de los eventos
# ($current_url, $host, $referrer, $referring_domain y sus $initial_*) para que no
# salgan con "localhost:3000", que el controller rechaza. Formato:
# https://test.<nombre-de-proyecto>.kuvus.app — un subdominio por proyecto, así las
# pruebas locales de cada showroom quedan separadas. Es opcional: sin ella los
# eventos salen con la URL real. Sólo tiene efecto con `next dev`; en cualquier
# build desplegado se ignora, aunque esté cargada en el panel del host.
# NEXT_PUBLIC_POSTHOG_MOCK_URL=https://test.mario-bravo.kuvus.app

# ── Editor de polígonos (herramienta interna, apagada en producción) ─────────
# Apagado por defecto → /admin y /api/admin responden 404. Ponelo en "true" para
# trazar los polígonos de stops y plantas en local (ver README § Editor de polígonos).
ENABLE_POLYGON_EDITOR=true
# Clave del Basic Auth del editor (sólo aplica si el editor está habilitado). En dev
# es opcional; en producción, sin clave el editor devuelve 401.
# ADMIN_PASSWORD=una-clave-larga
